# 复制为 .env 后按需修改；.env 不要提交到 Git
# 双模式：云端正式部署用 rds + redis，答辩断网/本地开发用 sqlite + memory
DB_MODE=sqlite
CACHE_MODE=memory

# 服务端口（契约固定 18080）
PORT=18080

# 华为云 RDS for MySQL（D4-D6 开通后填写）
RDS_HOST=
RDS_PORT=3306
RDS_USER=
RDS_PASSWORD=
RDS_DB=elevator

# 华为云 Redis（D4-D6 开通后填写）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
