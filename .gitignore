# 电梯困人主动预警 —— Git 忽略规则
# A / C 两侧规则并集；common/demo_data 下的 mp4/npy 必须保留。

# --- 敏感配置 ---
.env

# --- Python 环境 ---
.venv/
venv/
.venv-test/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/

# --- A 的开发辅助目录（本地 shim 与下载的 wheel） ---
.devenv/
.tmp/

# --- 模型权重：不进 Git（可由脚本重新获取/导出） ---
models/*.pt
models/*.onnx

# --- 实拍原始素材：体积大、可能涉及肖像 ---
data/raw/*
!data/raw/.gitkeep

# --- 本地数据库（sqlite 兜底） ---
elevator.db
elevator.db-journal

# --- 运行时产物 ---
*.log
results/*.tmp
results/bench_vision*.json

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini